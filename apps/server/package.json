{
  "name": "@smart-speed/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gridfs:verify": "tsx src/scripts/verify-gridfs.ts",
    "gridfs:cleanup": "tsx src/scripts/cleanup-frames.ts",
    "retention:apply": "tsx src/scripts/apply-retention.ts",
    "maintenance": "pnpm gridfs:verify && pnpm gridfs:cleanup --no-dry-run && pnpm retention:apply"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.2.0",
    "@smart-speed/shared": "workspace:*",
    "axios": "1.7.7",
    "bcrypt": "5.1.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "csv-stringify": "6.5.1",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.8.0",
    "multer": "1.4.5-lts.1",
    "node-cron": "3.0.3",
    "nodemailer": "6.9.16",
    "pdfkit": "0.15.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "socket.io": "4.8.1",
    "swagger-ui-express": "5.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "22.9.0",
    "@types/node-cron": "3.0.11",
    "@types/nodemailer": "6.4.17",
    "@types/pdfkit": "0.13.5",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "4.1.6",
    "mongodb-memory-server": "10.1.2",
    "pino-pretty": "13.0.0",
    "socket.io-client": "4.8.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
