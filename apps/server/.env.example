NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/smart-speed

# Auth — generate long random strings; never commit real values
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_LIFETIME_MINUTES=15
JWT_REFRESH_DAYS=7

# CORS allow-list (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Vision service
VISION_URL=http://localhost:8001
VISION_SHARED_SECRET=dev-vision-secret-change-me

# Public URL used to build frame links
PUBLIC_SERVER_URL=http://localhost:4000

# Frame uploads
MAX_FRAME_BYTES=4194304

LOG_LEVEL=info

# ── Email notifications (optional) ──────────────────────────────────────────
# Set NOTIFY_EMAIL_ENABLED=true and fill SMTP_* to send email alerts.
# Works with any SMTP server: Gmail, Sendgrid, Mailtrap, local relay, etc.
# Leave all unset to disable email (in-app / socket notifications still work).
NOTIFY_EMAIL_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Smart Speed <alerts@yourapp.com>"

# ── WhatsApp overspeed alerts (Meta WhatsApp Cloud API) ──────────────────────
# Every overspeed vehicle sends the admin(s) its camera photo + details.
# Setup steps: README.md -> "WhatsApp alerts". Off until enabled + filled in.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# admin numbers with country code, comma separated (e.g. 919876543210)
WHATSAPP_ADMIN_NUMBERS=
# optional approved template (image header + 5 variables) so alerts work
# without the admin messaging the number every 24 h; empty = plain image message
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# optional webhook (delivery receipts): Meta "Verify token" + App secret (App settings > Basic)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
NOTIFY_TIMEZONE=Asia/Kolkata
# optional: dashboard URL reachable from the phone, adds a link to each alert
# PUBLIC_WEB_URL=https://your-dashboard.example.com
