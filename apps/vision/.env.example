# Vision service (Python 3.11+)
SERVER_URL=http://localhost:4000
VISION_SHARED_SECRET=dev-vision-secret-change-me

# ── Camera source ─────────────────────────────────────────────────────────────
#   android -> Android phone over USB/ADB (what this build uses: Pixel 9a)
#   (empty) -> iPhone via macOS Continuity Camera (locked by the IDs below)
CAMERA_SOURCE=android

# Android (CAMERA_SOURCE=android). Needs: brew install scrcpy, USB debugging on,
# and the phone's Camera app CLOSED (only one app can use the camera at a time).
ANDROID_SERIAL=            # adb serial from `adb devices`; empty = the only attached phone
ANDROID_CAMERA_ID=0        # 0 = back camera (see `scrcpy --list-cameras`)
ANDROID_CAMERA_SIZE=1280x720
ANDROID_CAMERA_FPS=60      # 60 fps = shorter exposure = less motion blur
ANDROID_ROTATE=0           # 0 | 90 | 180 | 270 clockwise
ANDROID_TORCH=true         # phone flashlight on while streaming
# ANDROID_CAMERA_ZOOM=1.5

# iPhone Continuity Camera lock (only used when CAMERA_SOURCE is empty)
LIVE_CAMERA_UNIQUE_ID=E63B6BDD-EB3D-46B0-81D5-42D500000001
LIVE_CAMERA_MODEL_ID=iPhone15,5

# Ring buffer window (seconds) and capture tuning
RING_SECONDS=3
RING_FPS=60                # must match the camera fps (buffer = RING_SECONDS x RING_FPS frames)
CAPTURE_OFFSET_MS=200
JPEG_QUALITY=85
OVERLAY_CAPTION=true

# Frame choice: "motion" = sharpest frame around the crossing in which something moved
# (robust to timing offsets); "closest" = frame nearest eventTs - CAPTURE_OFFSET_MS
CAPTURE_MODE=motion
MOTION_BEFORE_MS=800
MOTION_AFTER_MS=700

# Optional YOLOv8n vehicle confirmation (off by default)
ENABLE_YOLO=false

HEARTBEAT_MS=5000
RECONNECT_MIN_MS=1000
RECONNECT_MAX_MS=30000
PORT=8001
LOG_LEVEL=INFO

# MJPEG preview token — must match web .env VITE_VISION_STREAM_TOKEN
LIVE_STREAM_TOKEN=ssd-live-demo
# Dashboard origins allowed to probe /health and render /live
VISION_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
