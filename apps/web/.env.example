# Same-origin paths — the Vite dev server proxies /api and /socket.io to :4000,
# which keeps the refresh cookie, frame images and Socket.IO free of CORS issues.
VITE_API_BASE=/api
VITE_SOCKET_URL=
# Vision service (iPhone Continuity Camera via FastAPI on :8001)
VITE_VISION_URL=http://localhost:8001
# Must match vision .env LIVE_STREAM_TOKEN (MJPEG /live endpoint)
VITE_VISION_STREAM_TOKEN=ssd-live-demo
