# Server this bridge reports to
SERVER_URL=http://localhost:4000

# Device API key (printed ONCE by the seed script / rotate endpoint)
DEVICE_API_KEY=

# Serial port override; empty = auto-detect /dev/cu.usbmodem*, /dev/cu.usbserial*, Arduino VID
SERIAL_PORT=
BAUD_RATE=115200

# Ordered disk queue — survives brief server outages, preserves order
QUEUE_FILE=.data/bridge-queue.jsonl
QUEUE_MAX=5000

# Heartbeat + reconnect backoff
HEARTBEAT_MS=5000
RECONNECT_MIN_MS=1000
RECONNECT_MAX_MS=30000

LOG_LEVEL=info
