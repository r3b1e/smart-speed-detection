# Root values consumed by docker-compose (each app also reads its own .env).
# Copy to .env before `docker compose up`. NEVER commit real secrets.

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_LIFETIME_MINUTES=15
JWT_REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
VISION_SHARED_SECRET=dev-vision-secret-change-me
PUBLIC_SERVER_URL=http://localhost:4000
LOG_LEVEL=info

VITE_API_BASE=http://localhost:4000/api
